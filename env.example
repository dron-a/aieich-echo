# Copy to .env for local runs. On Heroku these are config vars.
# Everything without a default below is required -- the bot reads them at
# import and fails immediately if one is missing.

# --- required ---
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
EVOLUTION_API_URL=https://your-whatsmiau-app.herokuapp.com/v1
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- LLM providers, tried in this order ---
# At least one key is needed for staged updates to apply. Dispatch works
# without any of them.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- scheduling ---
# 0  = Scheduler runs hourly at :00, dispatch the hour that is starting.
# 45 = Scheduler runs every 10 min, dispatch the next hour once past :45.
#      Costs ~10x the Neon compute hours; only use it if the lead is needed.
LEAD_MINUTES=0

# --- deadline boost ---
# Extra reminders as end_date nears, on top of the notice's own schedule.
# Intervals count back from end_date, so the deadline hour always fires.
BOOST_ENABLED=1
# threshold:interval pairs -- 12h+ out every 6h, 4-11h every 3h, under 4h
# hourly. Beyond the widest threshold nothing boosts. Malformed values fall
# back to this default with a warning.
BOOST_BANDS=12:6,4:3,0:1
# Which notice_kind values may boost. NULL counts as unknown.
BOOST_KINDS=deadline,unknown

# --- tuning, all optional ---
# LLM_CHUNK_SIZE=15
# LLM_DEADLINE_S=90
# LLM_TIMEOUT_S=60
# MAX_PENDING=200
# SEND_TIMEOUT_S=15
# SENT_LOG_RETENTION_DAYS=3
# HEALTH_WAIT_S=45
# WAKE_TIMEOUT_S=5
# CONNECT_TIMEOUT_S=30
# CONNECT_ATTEMPTS=4

# --- quips (cosmetic, last-day boost only) ---
QUIPS_ENABLED=1
# Probability of asking a model for a fresh line instead of the static list.
# 0 disables the LLM path; the static list still runs.
QUIP_LLM_CHANCE=0.3
# QUIP_TIMEOUT_S=8
# QUIP_MAX_CHARS=120

# --- mail bot (run.py runs it after echo_bot) ---
# Part 1 -- read new mail under a Gmail label and post a summary to the
# group. Needs 2FA enabled on the account and an app password, not the
# account password.
MAIL_ENABLED=1
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=ext_aisich
MAIL_TARGET_GROUP=1203630...@g.us
# First run, or after a Gmail folder reset, looks back this many days
# instead of replaying the whole label.
MAIL_LOOKBACK_DAYS=2
# MAIL_MAX_PER_RUN=25
# MAIL_BODY_CHARS=4000
# MAIL_SUMMARY_CHARS=900
# MAIL_LLM_DEADLINE_S=90

# Mail is notification-only. Dated items come from Taxila and Teams, which
# give exact dates and stable ids; announcements are logged to calendar.

# --- calendar bot (daily, after mail_bot) ---
CAL_ENABLED=1
# Upstream bot's Neon project, holding dim_taxila_usr.
TAXILA_DATABASE_URL=
# TAXILA_API_URL=https://taxila-aws.bits-pilani.ac.in/webservice/rest/server.php
# Hours between polls, per source. Reminders still dispatch hourly; these
# only gate the calendar fetches. Deadlines move, so Taxila is polled often;
# class and webinar schedules move rarely, so Teams is daily.
TAXILA_POLL_INTERVAL_H=4
TEAMS_POLL_INTERVAL_H=24
CAL_BACK_DAYS=30
CAL_FWD_DAYS=60
# CAL_TIMEOUT_S=30
# cal_bot.py only (by_timesort discovery + module enrichment):
# CAL_PAGE_SIZE=50
# CAL_MAX_PAGES=6
# cal_bot_monthly.py only -- months fetched per poll, this one and the next.
# CAL_MONTHS=2
# One extra call per poll for quiz time limits and attempt counts, which the
# monthly calendar view does not carry. Cosmetic: deadlines never depend on
# it. Set 0 if the module endpoint proves unreliable.
QUIZ_ENRICH=1

# Turn calendar rows into reminders. Kill switch, on by default.
CALENDAR_NOTICE_SYNC=1
CALENDAR_SYNC_BATCH=20
# Days before the deadline on which an automated reminder fires. Self-
# filtering: milestones before the item existed are dropped, so the count
# scales with how much notice there was. Keep the furthest under 28.
SYNC_DAYS_OUT=21,14,9,7,5,3,1,0

# --- group membership sync ---
# Runs when a user has never been synced (just registered) or their stamp is
# older than the refresh window. Group self-selection stays open for days
# after a course does, so a once-only sync would freeze an empty group.
GROUP_SYNC_ENABLED=1
GROUP_REFRESH_INTERVAL_H=24
# GROUP_MAX_USERS=10
# GROUP_TIMEOUT_S=30
# BITS_MAIL_DOMAIN=wilp.bits-pilani.ac.in

# --- course enrolment sync (monthly) ---
# Enrolments change at semester boundaries and almost never otherwise. A new
# user has course_synced_at NULL and is picked up on the next run regardless.
COURSE_SYNC_ENABLED=1
COURSE_REFRESH_INTERVAL_H=720
# COURSE_MAX_USERS=10

# --- course content sync (daily) ---
# Current-semester subject courses only, keyed on course so two students in
# one course fetch it once.
CONTENT_SYNC_ENABLED=1
CONTENT_REFRESH_INTERVAL_H=24
# CONTENT_MAX_COURSES=10
# CONTENT_TIMEOUT_S=60
COURSE_TIMEOUT_S=30

#---------- admin phones ----------
ADMIN_PHONES=911234567890